{
  "expo": {
    "name": "Cuentas Claras",
    "slug": "cuentas-claras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "cuentasclaras",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#B71C1C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cuentasclaras.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "La app necesita acceso a la camara para fotografiar comprobantes.",
        "NSPhotoLibraryUsageDescription": "La app necesita acceso a tus fotos para adjuntar comprobantes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#B71C1C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cuentasclaras.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para adjuntar comprobantes.",
          "cameraPermission": "La app necesita acceso a la camara para fotografiar comprobantes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#B71C1C"
        }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "100f66fb-7212-41f4-b472-e13a1e43ba9b"
      }
    },
    "owner": "nachoilero7"
  }
}
